# ==============================================================================
# GESTIO 229 SAAS — FICHIER EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Aucune valeur secrète ne doit figurer dans ce modèle.
# Dupliquer en .env.local pour l'environnement de développement local.
# En production (Vercel, Railway, VPS), configurer directement les secrets dans la plateforme.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT PUBLIC (ACCESSIBLE FRONTEND VITE / NEXT.JS)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVICE ROLE & POSTGRESQL (STRICTEMENT PRIVÉ / SERVEUR UNIQUEMENT)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
DATABASE_URL="postgres://postgres:your-db-password@your-pooler-url:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres:your-db-password@your-direct-url:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTIFICATION & SECRETS DE SESSION JWT
# ------------------------------------------------------------------------------
AUTH_SECRET="your-32-character-random-secret-for-jwt-session"

# ------------------------------------------------------------------------------
# 4. PASSERELLES DE PAIEMENT (FEDAPAY / KKIAPAY / MOBILE MONEY BÉNIN & UEMOA)
# ------------------------------------------------------------------------------
PAYMENT_API_KEY="your-payment-public-key"
PAYMENT_SECRET_KEY="your-payment-secret-private-key"
PAYMENT_WEBHOOK_SECRET="your-payment-webhook-signing-secret"

# ------------------------------------------------------------------------------
# 5. SYSTÈME FISCAL NORMALISÉ e-MECeF (BÉNIN / DGI)
# ------------------------------------------------------------------------------
EMECEF_API_KEY="your-emecef-api-key"
EMECEF_API_SECRET="your-emecef-api-secret"
EMECEF_ACCOUNT_ID="your-emecef-account-id"

# ------------------------------------------------------------------------------
# 6. CLÉS D'API PRIVÉES & PARTENAIRES
# ------------------------------------------------------------------------------
PRIVATE_API_KEY="your-private-api-key"
PRIVATE_API_SECRET="your-private-api-secret"

# ------------------------------------------------------------------------------
# 7. CONFIGURATION DU SERVEUR LOCAL
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 8. CONFIGURATION SMTP GMAIL (POUR L'ENVOI AUTOMATIQUE DES RAPPORTS DE CAISSE)
# ------------------------------------------------------------------------------
# Serveur SMTP (smtp.gmail.com pour Google Workspace ou compte Gmail)
SMTP_HOST="smtp.gmail.com"
# Port SMTP (587 avec STARTTLS)
SMTP_PORT="587"
# Adresse email de connexion (expéditeur Gmail SMTP authentifié)
SMTP_USER="votrecompte@gmail.com"
# Mot de passe d'application Google (16 caractères sans espaces, ex: abcd efgh ijkl mnop)
# À générer sur : https://myaccount.google.com/apppasswords
SMTP_PASS="votre-mot-de-passe-application-16-caracteres"
# Nom d'expéditeur affiché dans les emails
SMTP_FROM_NAME="GESTIO 229"
# Adresse email d'envoi affichée (recommandé : identique à SMTP_USER)
SMTP_FROM_EMAIL="votrecompte@gmail.com"

