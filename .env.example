# GESTIO 229 SAAS — VARIABLES D'ENVIRONNEMENT (.env.example)
# Copier ce fichier vers .env.local pour le développement local
# Configurer ces variables dans votre tableau de bord Vercel pour la production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (BASE DE DONNÉES & AUTHENTIFICATION)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://inknljnhqmrykcrgglts.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_GxeQWvSKrMpnH9VkAEfGFQ_I_uKxaXr"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. APPLICATION WEB & URL OFFICIELLE
# ------------------------------------------------------------------------------
VITE_APP_URL="https://gestio229.com"

# ------------------------------------------------------------------------------
# 3. PAIEMENTS & MOBILE MONEY BÉNIN
# ------------------------------------------------------------------------------
VITE_MTN_MOMO_API_URL="https://sandbox.momodeveloper.mtn.com"
VITE_MTN_MOMO_SUBSCRIPTION_KEY="your-momo-subscription-key"
VITE_MTN_MOMO_TARGET_ENV="sandbox"

# ------------------------------------------------------------------------------
# 4. GÉOLOCALISATION & FLOTTE
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ------------------------------------------------------------------------------
# 5. EXPÉDITION DES RAPPORTS DE CAISSE (MULTI-FOURNISSEURS RÉSILIENT)
# ------------------------------------------------------------------------------
# OPTION 1 (RECOMMANDÉE EN PRODUCTION VERCEL) : API TRANSACTIONNELLE RESEND (HTTPS 443)
# Résout définitivement l'erreur "Connection closed unexpectedly" des sockets SMTP sur cloud.
# Obtenir gratuitement une clé (3 000 emails/mois) sur https://resend.com
RESEND_API_KEY="re_votre_cle_resend"

# OPTION 2 : API TRANSACTIONNELLE BREVO / SENDINBLUE (HTTPS 443)
# Obtenir gratuitement une clé (300 emails/jour) sur https://brevo.com
BREVO_API_KEY="xkeysib-votre_cle_brevo"

# OPTION 3 : GMAIL SMTP DIRECT (PORT 465 SSL OU 587 STARTTLS)
# Attention : Les hébergeurs cloud serverless (Vercel/AWS) bloquent fréquemment les connexions TCP brutes
# vers smtp.gmail.com ("Connection closed unexpectedly"). Utilisez Resend API si blocage.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="votrecompte@gmail.com"
# Mot de passe d'application Google (16 caractères générés sur https://myaccount.google.com/apppasswords)
SMTP_PASS="votre-mot-de-passe-application-16-caracteres"
SMTP_FROM_NAME="GESTIO 229"
SMTP_FROM_EMAIL="votrecompte@gmail.com"
