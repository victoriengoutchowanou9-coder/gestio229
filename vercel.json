{
  "crons": [],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(index.html|sw.js|push-worker.js|registerSW.js|manifest.webmanifest|manifest.json|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/resend-confirmation-email",
      "destination": "/api/confirm-email"
    },
    {
      "source": "/api/admin-feedback",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/admin-push",
      "destination": "/api/admin-data"
    },
    {
      "source": "/api/test-email",
      "destination": "/api/send-rapport-pdf?action=test-email"
    },
    {
      "source": "/api/cron-rapport-caisse",
      "destination": "/api/send-rapport-pdf?action=cron"
    },
    {
      "source": "/api/sector-request",
      "destination": "/api/company-clear-sector?action=sector-request"
    },
    {
      "source": "/api/verify-access",
      "destination": "/api/company-clear-sector?action=verify-access"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gestio229.vercel.app"
        }
      ],
      "destination": "https://gestio229.com/$1",
      "permanent": true
    }
  ]
}
